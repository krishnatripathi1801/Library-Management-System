@{
    ViewData["Title"] = "About Us";
}

<div class="bg-white rounded shadow-sm p-4 p-md-5 mt-4 mb-5">
    <h2 class="mb-4 fw-bold text-dark">About Us</h2>
    <p class="text-muted lead">Welcome to LibraryManagement, your ultimate portal for digital and physical resource tracking.</p>
    <p class="text-secondary">
        Our mission is to simplify school and university cataloging by providing a seamless, fast, and secure
        database solution for students and administrators alike. Manage books, check availability times, and
        handle borrowing requests with just a few clicks.
    </p>

    <div class="row mt-5">
        <div class="col-md-4">
            <h5 class="fw-bold">Our Vision</h5>
            <p class="text-muted small">To build connected environments where academic resources are accessible to everyone, instantly.</p>
        </div>
        <div class="col-md-4">
            <h5 class="fw-bold">Smart Tracking</h5>
            <p class="text-muted small">Monitor real-time item checkouts, pending return dates, and stock limits automatically.</p>
        </div>
        <div class="col-md-4">
            <h5 class="fw-bold">Easy Access</h5>
            <p class="text-muted small">A clean interface optimized for desktop, tablet, and mobile screens alike.</p>
        </div>
    </div>
</div>
